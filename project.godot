; Engine configuration file.
; Open this folder in the free Godot 4 editor and press Play (F5).

config_version=5

[application]

config/name="Doctors World"
config/description="An original story game about one doctor's career, from first day to Chief of Medicine."
config/version="1.18.1"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/icon.png"

[audio]

; Play sound with the ring/silent switch on silent; the game has its own volume settings.
general/ios/session_category=3
; Characters read their lines aloud with the device's own voices (Speech).
general/text_to_speech=true

[display]

window/size/viewport_width=1688
window/size/viewport_height=780
window/size/window_width_override=1266
window/size/window_height_override=585
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor_plugins]

; Adds the reminders code to the iOS build (see addons/dw_reminders).
enabled=PackedStringArray("res://addons/dw_reminders/plugin.cfg")

[input]

phone={
"deadzone": 0.2,
