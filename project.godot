; Engine configuration file.
; Open this folder in the free Godot 4 editor and press Play (F5).

config_version=5

[application]

config/name="Doctors World"
config/description="An original story game about one doctor's career, from first day to Chief of Medicine."
config/version="0.7.0"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/icon.png"

[display]

window/size/viewport_width=1688
window/size/viewport_height=780
window/size/window_width_override=1266
window/size/window_height_override=585
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
