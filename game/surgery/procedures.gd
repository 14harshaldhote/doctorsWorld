const TIMEOUT_TEXT := {"confirm": "Confirm", "stop": "Stop, that's wrong", "unsure": "Not sure"}


## A procedure by id, with the defaults filled in. Unknown ids give the
## appendectomy.
static func get_procedure(id: String) -> Dictionary:
	var made: Dictionary
	match id:
		"wound":
			made = _wound()
		"gallbladder":
			made = _gallbladder()
		"hernia":
			made = _hernia()
		"hip":
			made = _hip()
		"spleen":
			made = _spleen()
		_:
			made = _appendix()
	var defaults := {
		"pronoun": "he", "theatre": "Theatre 2", "lead": "iyer", "tray": Instruments.ALL.duplicate(),
		"count": true, "opens": "retract", "pool": ["bleeding", "pressure"], "lines": {}, "slots": {},
		"antibiotic": "co-amoxiclav", "base_swabs": 3,
	}
	for key: String in defaults:
		if not made.has(key):
			made[key] = defaults[key]
	return made


static func ids() -> Array[String]:
	return ["appendix", "wound", "gallbladder", "hernia", "hip", "spleen"]


## A complication's data, with the procedure's own lines laid over it.
static func complication(procedure: Dictionary, which: String) -> Dictionary:
	var made: Dictionary = (COMPLICATIONS.get(which, {}) as Dictionary).duplicate(true)
	var own: Dictionary = (procedure.get("lines", {}) as Dictionary).get(which, {})
	made.merge(own, true)
	return made


